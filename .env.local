# Local development environment for Fydell.
# Generated so signed employer sessions (login/signup) work out of the box.
# Replace NEXTAUTH_SECRET with `openssl rand -base64 32` for anything shared.

# --- Session signing (REQUIRED for login/signup) ---------------------------
NEXTAUTH_SECRET=fydell_local_dev_secret_8f2b1c4d9e6a7350b2d1f8c3a4e5907612cd34ef5a6b7890

# --- App URL ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (optional in dev; auth falls back to local .data/ file store) -
# Fill these in to back accounts with Supabase instead of the local file store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (optional; billing degrades gracefully if unset) ----------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=
STRIPE_PILOT_PRICE_ID=
