# ============================================================================
# Fydell Backend MVP — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Project URL + keys from the Supabase dashboard (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Session signing --------------------------------------------------------
# Secret used to sign the httpOnly employer session cookie (jose / HS256).
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# --- App URL ----------------------------------------------------------------
# Public base URL — used for candidate invite links and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (optional; billing degrades gracefully if unset) ----------------
# Secret + webhook secret are SERVER ONLY. Only the publishable key is public.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two MVP plans (create them in the Stripe dashboard).
STRIPE_TEAM_PRICE_ID=
STRIPE_PILOT_PRICE_ID=
